.ar-pppp.cv img,
.ar-ppp.cv img,
.ar-pp.cv img,
.ar-p.cv img,
.ar-s.cv img,
.ar-l.cv img,
.ar-ll.cv img,
.ar-lll.cv img,
.ar-llll.cv img,
.ar-lllll.cv img {
  object-fit: cover; }

