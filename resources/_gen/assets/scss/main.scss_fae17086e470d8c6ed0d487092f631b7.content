.flex {
  display: flex; }

.flex-grow {
  display: flex;
  flex-grow: 1; }

.flex-shrink {
  display: flex;
  flex-shrink: 1; }

:root {
  --font-size: 15px;
  --cell-size: calc(var(--font-size) * 2);
  --grid-padding: 3;
  --grid-cells: 30;
  /* Color */
  --color-moss: #565e3b;
  --color-green: #6a8616;
  --color-yellow: #ffdc13;
  --color-olive: #677736;
  --color-grid-line: #a1c6ba;
  --color-text-base: #2a2624;
  --color-text-light: #857e7a;
  --color-text-hover: var(--color-olive);
  --color-blockquote-border: var(--color-olive);
  --color-blockquote-text: var(--color-olive);
  --color-bg: #faf9f2;
  /* TYPOGRAPHY */
  /* Font Families */
  --font-sans: "Inter", sans-serif;
  --font-serif: "Inclusive Sans", serif;
  --font-handwritten: "MD038", sans-serif;
  --font-sharpie: "Canary Post", sans-serif;
  --font-size-600: calc(var(--font-size) * 1.4);
  --font-size-500: calc(var(--font-size) * 1.25);
  --font-size-400: calc(var(--font-size) * 1.1);
  --font-size-300: calc(var(--font-size) * 1.05);
  --font-size-200: calc(var(--font-size) * 1.025);
  --font-size-100: calc(var(--font-size) * 1);
  --font-size-000: var(--font-size);
  /* Grid Sizing */
  --text-h-offset: calc(var(--font-size) / 3);
  /* Theme Colors */
  --grid-paper-bg: var(--color-paper-bg);
  --grid-line-color: var(--color-grid-line);
  --text-heading-color: var(--color-text-base);
  --text-body-color: var(--color-text-base);
  --text-color-light: var(--color-text-light);
  --blockquote-border-color: var(--color-blockquote-border);
  --font-family-primary: var(--font-serif);
  --color-primary: var(--color-olive); }

h1,
h2,
h3,
h4,
h5,
h6,
p,
span,
summary {
  padding: 0px var(--text-h-offset); }

h1, .fs-6 {
  font-weight: 700;
  font-size: var(--font-size-600);
  margin-top: var(--cell-size); }

h2, .fs-5 {
  font-size: var(--font-size-500);
  margin-block: var(--cell-size);
  font-weight: 600; }

h3, .fs-4 {
  font-size: var(--font-size-400);
  margin-block: var(--cell-size);
  font-weight: 600; }

h4, .fs-3 {
  font-size: var(--font-size-300);
  margin-top: var(--cell-size);
  font-weight: 500; }

h5, .fs-2 {
  font-size: var(--font-size-200);
  margin-top: var(--cell-size);
  font-weight: 500; }

h6, .fs-1 {
  font-size: var(--font-size-100);
  margin-top: var(--cell-size);
  font-weight: 500; }

p {
  margin-top: var(--cell-size); }

blockquote {
  padding-inline: calc(var(--cell-size) - 2px) var(--cell-size);
  border-left: 2px solid var(--color-blockquote-border);
  color: var(--color-blockquote-text);
  margin-block: var(--cell-size); }

a,
.font-link {
  color: inherit; }

a:hover {
  color: var(--color-olive); }

.link-clear {
  text-decoration: none; }

.link-hide {
  text-decoration: none; }

.link-hide:hover {
  text-decoration: underline; }

.nav-link:hover {
  text-decoration: none; }

#identity {
  font-family: var(--font-handwritten);
  font-size: calc(var(--font-size) * 2);
  transform: translateY(calc(var(--font-size) * .3)); }

ul,
ol {
  margin-top: 0;
  padding-right: var(--text-h-offset);
  list-style-position: inside; }

ul {
  padding-left: calc(var(--cell-size) * 1.4); }

ol {
  padding-left: var(--cell-size);
  list-style: none;
  counter-reset: list_counter; }

ol li {
  counter-increment: list_counter; }

ol li::before {
  content: counter(list_counter) ". ";
  width: var(--cell-size);
  height: var(--cell-size);
  display: inline-block;
  line-height: var(--cell-size);
  text-align: center;
  margin-right: var(--text-h-offset); }

details:hover summary {
  cursor: pointer;
  color: var(--color-text-hover); }

summary:focus-visible {
  outline: var(--color-text-hover) 1px auto;
  border-radius: 0px; }

details {
  margin-top: var(--cell-size);
  box-shadow: 0px 1px 0px var(--color-grid-line); }

details nav ul {
  margin-bottom: var(--cell-size);
  padding-bottom: var(--cell-size); }

p a[href^="https://www"]:not([href*="matthewdillard.me"]), span a[href^="https://www"]:not([href*="matthewdillard.me"]) {
  display: inline-flex;
  text-decoration: none;
  align-items: center;
  margin: 0;
  text-decoration: underline; }

p a[href^="https://www"]:not([href*="matthewdillard.me"]):hover, span a[href^="https://www"]:not([href*="matthewdillard.me"]):hover {
  text-decoration: underline; }

p a[href^="https://www"]:not([href*="matthewdillard.me"])::after, span a[href^="https://www"]:not([href*="matthewdillard.me"])::after {
  content: "";
  display: inline-block;
  width: 1em;
  height: 1em;
  margin-left: .1em;
  background-color: #aaa;
  mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="m256-240-56-56 384-384H240v-80h480v480h-80v-344L256-240Z"/></svg>') no-repeat center;
  mask-size: contain;
  -webkit-mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 -960 960 960"><path d="m256-240-56-56 384-384H240v-80h480v480h-80v-344L256-240Z"/></svg>') no-repeat center;
  -webkit-mask-size: contain;
  opacity: 1; }

p a[href^="https://www"]:not([href*="matthewdillard.me"]):hover::after, span a[href^="https://www"]:not([href*="matthewdillard.me"]):hover::after {
  background-color: var(--color-olive); }

.project-list .list-item {
  display: flex;
  flex-direction: row;
  flex-wrap: wrap; }
  .project-list .list-item p, .project-list .list-item h2 {
    margin-top: 0px; }
  .project-list .list-item:not(:last-child) {
    margin-bottom: var(--cell-size); }

.meta-span-block {
  width: calc(var(--cell-size) * 4); }

.postit__wrap {
  padding: var(--cell-size); }

.postit {
  position: relative;
  transition: all 0.33s cubic-bezier(0.19, 1, 0.22, 1);
  width: 100%;
  height: 100%;
  aspect-ratio: 1 / 1;
  border-radius: 0.5vh;
  background: #F5DB11;
  padding: 7%; }
  .postit .postit__text {
    position: relative;
    display: flex;
    align-items: center;
    aspect-ratio: 1; }
    .postit .postit__text textarea {
      font-family: 'Gold Post';
      resize: none;
      font-size: 4vh;
      line-height: 1.3;
      text-transform: capitalize;
      background: none;
      border: none;
      width: 100%;
      height: 100%;
      overflow: hidden; }
    .postit .postit__text textarea:focus-visible {
      outline: none; }
  .postit .postit-shadow {
    opacity: 0.25;
    filter: blur(11px);
    background-image: linear-gradient(359deg, black, rgba(0, 0, 0, 0) 73%);
    position: absolute;
    inset: 0%;
    z-index: -1;
    transition: opacity 0.33s ease-in; }
  .postit:hover .postit-shadow {
    opacity: 0.4; }

:has(> iframe[src^="https://www.youtube.com"]) {
  padding-bottom: 60% !important; }

.taxonomy-list {
  list-style: none;
  padding-inline: var(--text-h-offset);
  margin-block: var(--cell-size); }
  .taxonomy-list li {
    display: inline-block; }
  .taxonomy-list li:last-child {
    margin-right: 0px; }

